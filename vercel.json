{
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:dir(.*)/index.html", "destination": "/:dir", "permanent": true },
    { "source": "/:path(.*)\\.html", "destination": "/:path", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/broker",
      "destination": "/broker.html"
    },
    {
      "source": "/(?:[^/]+/)+(js|css|assets|docs|legacy)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/((?!css/|js/|assets/|docs/|legacy/|api/|[^/]+\\.[a-zA-Z0-9]+$).*)",
      "destination": "/api/render"
    }
  ],
  "functions": {
    "api/render.mjs": {
      "includeFiles": "{index.html,js/content/manifests/index.js}"
    }
  }
}
